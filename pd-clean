#!/bin/bash
# ==============================================================================
# PD-CLEAN: Parallels Desktop Time-Bypass, Launcher & Snapshot Manager (Optimized)
# ==============================================================================

VERSION="2.7.1"
PLIST="/var/root/Library/Preferences/com.parallels.desktop.plist"
EPOCH_CACHE="/var/root/.pd_real_epoch"
SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# ANSI Colors
R=$'\033[0;31m'; G=$'\033[0;32m'; Y=$'\033[1;33m'; B=$'\033[0;34m'; C=$'\033[0;36m'; N=$'\033[0m'
info() { echo "${B}[INFO]${N} $*"; }
ok()   { echo "${G}[ OK ]${N} $*"; }
warn() { echo "${Y}[WARN]${N} $*"; }
err()  { echo "${R}[ERR ]${N} $*" >&2; }

show_help() {
  cat <<EOF
${C}PD-CLEAN v${VERSION}${N} - Parallels Desktop Bypass & Snapshot Tool

${Y}Usage:${N}
  $(basename "$0") [options]

${Y}Options:${N}
  (no args)            Start/Resume VM directly with time-bypass & real-time sync
  -r [num]             Revert to latest snapshot (or snapshot #<num>) before starting
  -s, --select         Show interactive snapshot table to select and revert
  -l, --list           List all snapshots without starting/modifying time
  -c, --create <name>  Create a new snapshot before starting
  -x, --delete [num]   Delete snapshot interactively, by #<num>, or 'all' (and exit)
  -d, --date <date>    Set custom started_at date (format: YYYY-MM-DD) in plist
  -k, --kill           Force kill all running Parallels processes and exit
  -f, --fix-time       Force restore macOS real-time clock immediately and exit
  -y, --yes            Skip confirmation prompts
  --install            Install globally to /usr/local/bin/pd-clean
  -h, --help           Show this help message
EOF
  exit 0
}

[[ "$1" == "-h" || "$1" == "--help" ]] && show_help

# 1. Root Escalation
if (( EUID != 0 )); then
  echo "${C}=== PD-CLEAN v${VERSION} ===${N}"
  sudo -k
  exec sudo "$SCRIPT_PATH" "$@"
fi

# 2. Argument Parsing
MODE="none"
SNAP_ARG=""
CUSTOM_DATE=""
FORCE_KILL=0

while (( $# > 0 )); do
  case "$1" in
    -r|--revert)
      MODE="latest"
      if [[ "$2" =~ ^[0-9]+$ ]]; then MODE="index"; SNAP_ARG="$2"; shift; fi
      ;;
    -s|--select)   MODE="select" ;;
    -l|--list)     MODE="list_only" ;;
    -c|--create)   MODE="create"; SNAP_ARG="${2:-AutoSnap_$(date +%Y%m%d_%H%M)}"; shift ;;
    -x|--delete|--rm)
      MODE="delete"
      if [[ -n "$2" && "$2" != -* ]]; then SNAP_ARG="$2"; shift; fi
      ;;
    -d|--date)     CUSTOM_DATE="$2"; shift ;;
    -k|--kill)     MODE="kill_only" ;;
    -f|--fix-time) MODE="fix_time_only" ;;
    --install)     MODE="install" ;;
    -y|--yes)      FORCE_KILL=1 ;;
    -h|--help)     show_help ;;
    *)             err "Unknown option: $1"; show_help ;;
  esac
  shift
done

REAL_USER="${SUDO_USER:-$(stat -f '%Su' /dev/console)}"
REAL_UID=$(id -u "$REAL_USER")
USER_HOME=$(dscl . -read "/Users/$REAL_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
[[ -z "$USER_HOME" ]] && USER_HOME="/Users/$REAL_USER"

as_user() {
  launchctl asuser "$REAL_UID" sudo -u "$REAL_USER" "$@"
}

# 3. Global Install
if [[ "$MODE" == "install" ]]; then
  mkdir -p /usr/local/bin
  LC_ALL=C sed 's/\xc2\xa0/ /g' "$SCRIPT_PATH" > /usr/local/bin/pd-clean
  chmod 755 /usr/local/bin/pd-clean
  [[ -d "/opt/homebrew/bin" ]] && ln -sf /usr/local/bin/pd-clean /opt/homebrew/bin/pd-clean
  ok "Installed successfully to /usr/local/bin/pd-clean (v${VERSION})"
  exit 0
fi

[[ -d "/Applications/Parallels Desktop.app" ]] || { err "Parallels Desktop not installed."; exit 1; }

# 4. Fast Time Recovery (Online / Cache / Sudo Timestamp)
SAVED_EPOCH=0
RESTORE_PERFORMED=0

fetch_network_epoch() {
  local hdr ts
  for url in "http://captive.apple.com" "https://1.1.1.1" "https://www.google.com"; do
    hdr=$(curl -skI --connect-timeout 1 --max-time 1.5 "$url" 2>/dev/null | awk 'tolower($1)=="date:" {sub(/^[^:]+:[[:space:]]*/, ""); sub(/\r$/, ""); print; exit}')
    if [[ -n "$hdr" ]]; then
      ts=$(LC_ALL=C date -juf "%a, %d %b %Y %H:%M:%S %Z" "$hdr" +%s 2>/dev/null)
      (( ts > 1700000000 )) && { echo "$ts"; return 0; }
    fi
  done
  return 1
}

restore_time() {
  (( RESTORE_PERFORMED == 1 )) && return 0
  RESTORE_PERFORMED=1

  local target_ts=0 net_ts
  if net_ts=$(fetch_network_epoch); then
    target_ts=$net_ts
  elif (( SAVED_EPOCH > 0 )); then
    target_ts=$(( SAVED_EPOCH + SECONDS ))
  elif [[ -f "$EPOCH_CACHE" ]]; then
    target_ts=$(( $(<"$EPOCH_CACHE") + SECONDS ))
  fi

  if (( target_ts > 1700000000 )); then
    date "$(date -r "$target_ts" "+%m%d%H%M%Y.%S")" >/dev/null 2>&1
    echo "$target_ts" > "$EPOCH_CACHE"
  fi

  systemsetup -setusingnetworktime on >/dev/null 2>&1
  killall -9 timed 2>/dev/null
  launchctl kickstart -k system/com.apple.timed 2>/dev/null
  rm -rf /var/db/sudo/ts/* 2>/dev/null

  ok "macOS time restored: $(date)"
}

# 5. Snapshot Engine (Native XML Parsing & Clean Output)
load_snapshots() {
  local vm_id="$1"
  local vm_home snap_xml raw_snap active_snap

  for (( attempt=1; attempt<=3; attempt++ )); do
    SNAP_IDS=()
    SNAP_LINES=()

    vm_home=$(as_user prlctl list -i "$vm_id" 2>/dev/null | awk -F': ' '/^Home:/ {print $2; exit}')
    snap_xml="${vm_home%/}/Snapshots.xml"

    if [[ ! -f "$snap_xml" ]]; then
      snap_xml=$(find "$USER_HOME/Parallels" "/Users/Shared/Parallels" -maxdepth 3 -name "Snapshots.xml" 2>/dev/null | head -n 1)
    fi

    raw_snap=$(as_user prlctl snapshot-list "$vm_id" 2>/dev/null)
    active_snap=$(echo "$raw_snap" | grep -oE '\*\{[0-9a-fA-F-]{36}\}' | tr -d '*')

    if [[ -f "$snap_xml" ]]; then
      while IFS='|' read -r sid scur sdate sstate sname sdesc; do
        [[ -z "$sid" ]] && continue
        SNAP_IDS+=("$sid")
        SNAP_LINES+=("$(printf "%-3s | %-14.14s | %-19s | %-8s | %s %s" "$scur" "$sname" "$sdate" "$sstate" "$sid" "${sdesc:+($sdesc)}")")
      done < <(python3 -c '
import xml.etree.ElementTree as ET, sys
try:
    root = ET.parse(sys.argv[1]).getroot()
    cur = (sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else root.attrib.get("CurrentSnapshot", "")).lower()
    for item in root.iter("SavedStateItem"):
        guid = item.attrib.get("guid", "").strip()
        if not guid: continue
        name = (item.findtext("Name") or "Unnamed").strip()
        dt   = (item.findtext("DateTime") or "N/A").strip()
        st   = (item.findtext("VmState") or item.findtext("State") or item.attrib.get("state") or "saved").strip()
        desc = (item.findtext("Description") or "").strip().replace("\n", " ")
        mark = " * " if guid.lower() == cur else "   "
        print(f"{guid}|{mark}|{dt}|{st}|{name}|{desc}")
except Exception:
    pass
' "$snap_xml" "$active_snap" 2>/dev/null)
    fi

    # Fallback CLI
    if (( ${#SNAP_IDS[@]} == 0 )) && [[ -n "$raw_snap" ]]; then
      local unique_ids
      unique_ids=$(echo "$raw_snap" | awk 'NR>1 {print $NF}' | tr -d '*' | grep -oE '\{[0-9a-fA-F-]{36}\}' | sort -u)
      while IFS= read -r id; do
        [[ -z "$id" ]] && continue
        SNAP_IDS+=("$id")
        local mark="   "
        [[ "$(echo "$id" | tr '[:upper:]' '[:lower:]')" == "$(echo "$active_snap" | tr '[:upper:]' '[:lower:]')" ]] && mark=" * "
        SNAP_LINES+=("$(printf "%-3s | %-14.14s | %-19s | %-8s | %s" "$mark" "Snapshot" "N/A" "saved" "$id")")
      done <<< "$unique_ids"
    fi

    (( ${#SNAP_IDS[@]} > 0 )) && return 0
    sleep 0.5
  done
  return 1
}

print_snapshot_table() {
  echo ""
  echo "=========================================================================================="
  printf " %-4s | %-3s | %-14s | %-19s | %-8s | %s\n" "No." "Cur" "Snapshot Name" "Created Date" "State" "Snapshot UUID / Description"
  echo "------------------------------------------------------------------------------------------"
  for idx in "${!SNAP_IDS[@]}"; do
    printf " [%2d] | %s\n" "$((idx+1))" "${SNAP_LINES[$idx]}"
  done
  echo "=========================================================================================="
}

# 6. Utility Modes (-f, -k, -l)
if [[ "$MODE" == "fix_time_only" ]]; then
  restore_time
  exit 0
fi

if [[ "$MODE" == "kill_only" ]]; then
  info "Killing Parallels processes..."
  killall "Parallels Desktop" prl_client_app prl_vm_app 2>/dev/null
  ok "Parallels processes terminated."
  exit 0
fi

if [[ "$MODE" == "list_only" ]]; then
  VM_LINE=$(as_user prlctl list -a --no-header -o uuid,name 2>/dev/null | head -n 1)
  VM_UUID=$(echo "$VM_LINE" | awk '{print $1}')
  load_snapshots "$VM_UUID"
  (( ${#SNAP_IDS[@]} == 0 )) && { warn "No snapshots found."; exit 0; }
  print_snapshot_table
  exit 0
fi

# 7. Plist Date Optimization
update_plist() {
  local target_val="$1"
  [[ -f "$PLIST" ]] || plutil -create xml1 "$PLIST" 2>/dev/null
  plutil -replace "started_at" -string "$target_val" "$PLIST" 2>/dev/null || \
  plutil -insert "started_at" -string "$target_val" "$PLIST" 2>/dev/null
  killall cfprefsd 2>/dev/null
}

DATE_REGEX='^(202[0-9])-([0-9]{2})-([0-9]{2})$'

if [[ -n "$CUSTOM_DATE" && "$CUSTOM_DATE" =~ $DATE_REGEX ]]; then
  YYYY="${BASH_REMATCH[1]}"; MM="${BASH_REMATCH[2]}"; DD="${BASH_REMATCH[3]}"
  info "Setting custom started_at: $CUSTOM_DATE"
  update_plist "$CUSTOM_DATE"
else
  EXISTING_DATE=$(plutil -extract "started_at" raw "$PLIST" 2>/dev/null)
  if [[ "$EXISTING_DATE" =~ $DATE_REGEX ]]; then
    YYYY="${BASH_REMATCH[1]}"; MM="${BASH_REMATCH[2]}"; DD="${BASH_REMATCH[3]}"
  else
    PLIST_CONTENT=$(plutil -p "$PLIST" 2>/dev/null)
    if [[ "$PLIST_CONTENT" =~ (202[0-9])-([0-9]{2})-([0-9]{2}) ]]; then
      YYYY="${BASH_REMATCH[1]}"; MM="${BASH_REMATCH[2]}"; DD="${BASH_REMATCH[3]}"
    else
      YYYY="2026"; MM="11"; DD="10"
    fi
    DETECTED_DATE="${YYYY}-${MM}-${DD}"
    info "Patching started_at ($DETECTED_DATE) into plist..."
    update_plist "$DETECTED_DATE"
  fi
fi

FAKE_YMD="${YYYY}${MM}${DD}"
MAC_DATE="${MM}${DD}0000${YYYY}"

# 8. Delete Snapshot Mode (-x / --delete)
if [[ "$MODE" == "delete" ]]; then
  VM_LINE=$(as_user prlctl list -a --no-header -o uuid,name 2>/dev/null | head -n 1)
  VM_UUID=$(echo "$VM_LINE" | awk '{print $1}')
  load_snapshots "$VM_UUID"
  (( ${#SNAP_IDS[@]} == 0 )) && { warn "No snapshots found to delete."; exit 0; }

  DEL_TARGETS=()

  if [[ -z "$SNAP_ARG" ]]; then
    print_snapshot_table
    read -r -p "Enter snapshot number to DELETE [1-${#SNAP_IDS[@]}, 'all', or 0 to cancel]: " d_choice
    [[ -z "$d_choice" || "$d_choice" == "0" ]] && { info "Canceled."; exit 0; }
    SNAP_ARG="$d_choice"
  fi

  if [[ "$SNAP_ARG" == "all" ]]; then
    if (( FORCE_KILL == 0 )); then
      read -r -p "Are you sure you want to delete ALL ${#SNAP_IDS[@]} snapshot(s)? (y/N): " confirm
      [[ "$confirm" =~ ^[Yy]$ ]] || { info "Canceled."; exit 0; }
    fi
    DEL_TARGETS=("${SNAP_IDS[@]}")
  elif [[ "$SNAP_ARG" =~ ^[0-9]+$ ]] && (( SNAP_ARG > 0 && SNAP_ARG <= ${#SNAP_IDS[@]} )); then
    DEL_TARGETS=("${SNAP_IDS[$((SNAP_ARG-1))]}")
  else
    err "Invalid snapshot selection: $SNAP_ARG (Valid: 1-${#SNAP_IDS[@]} or 'all')."
    exit 1
  fi

  TIME_SPOOFED_FOR_DEL=0
  if [[ -z "$VM_UUID" ]]; then
    trap 'restore_time' EXIT INT TERM
    SAVED_EPOCH=$(fetch_network_epoch || date +%s)
    SECONDS=0
    systemsetup -setusingnetworktime off >/dev/null 2>&1
    date "$MAC_DATE" >/dev/null
    TIME_SPOOFED_FOR_DEL=1
    as_user open -a "Parallels Desktop"
    for (( i=0; i<20; i++ )); do
      VM_UUID=$(as_user prlctl list -a --no-header -o uuid 2>/dev/null | head -n 1 | tr -d '[:space:]')
      [[ -n "$VM_UUID" ]] && break
      sleep 0.5
    done
  fi

  for del_id in "${DEL_TARGETS[@]}"; do
    info "Deleting snapshot $del_id..."
    if ! as_user prlctl snapshot-delete "$VM_UUID" --id "$del_id" 2>/dev/null; then
      if (( TIME_SPOOFED_FOR_DEL == 0 )); then
        trap 'restore_time' EXIT INT TERM
        SAVED_EPOCH=$(fetch_network_epoch || date +%s)
        SECONDS=0
        systemsetup -setusingnetworktime off >/dev/null 2>&1
        date "$MAC_DATE" >/dev/null
        TIME_SPOOFED_FOR_DEL=1
      fi
      as_user prlctl snapshot-delete "$VM_UUID" --id "$del_id"
    fi
  done

  (( TIME_SPOOFED_FOR_DEL == 1 )) && restore_time
  ok "Snapshot deletion completed."
  exit 0
fi

trap 'restore_time' EXIT INT TERM

# 9. Save Host Epoch Before Spoofing
if NET_NOW=$(fetch_network_epoch); then
  SAVED_EPOCH=$NET_NOW
elif [[ "$(date +%Y%m%d)" != "$FAKE_YMD" ]]; then
  SAVED_EPOCH=$(date +%s)
elif [[ -f "$EPOCH_CACHE" ]]; then
  SAVED_EPOCH=$(<"$EPOCH_CACHE")
else
  SAVED_EPOCH=$(stat -f "%m" /var/log/system.log 2>/dev/null || date +%s)
fi

echo "$SAVED_EPOCH" > "$EPOCH_CACHE"
SECONDS=0

# 10. Clean Running Instances
if pgrep -f "Parallels Desktop|prl_client_app|prl_vm_app" >/dev/null; then
  if (( FORCE_KILL == 0 )); then
    read -r -p "Parallels is currently running. Force restart it? (y/n): " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { RESTORE_PERFORMED=1; exit 0; }
  fi
  info "Stopping running Parallels processes..."
  if [[ "$MODE" =~ ^(latest|index|select)$ ]]; then
    RUNNING_VM=$(as_user prlctl list --no-header -o uuid 2>/dev/null | head -n 1 | tr -d '[:space:]')
    [[ -n "$RUNNING_VM" ]] && as_user prlctl stop "$RUNNING_VM" --kill >/dev/null 2>&1
  fi
  killall "Parallels Desktop" prl_client_app prl_vm_app 2>/dev/null
  sleep 0.5
fi

# 11. Clock Spoof & Launch
info "Bypassing clock -> ${YYYY}-${MM}-${DD}..."
systemsetup -setusingnetworktime off >/dev/null 2>&1
date "$MAC_DATE" >/dev/null

as_user open -a "Parallels Desktop"

VM_UUID=""
for (( i=0; i<40; i++ )); do
  if pgrep -f prl_client_app >/dev/null; then
    VM_LINE=$(as_user prlctl list -a --no-header -o uuid,status,name 2>/dev/null | head -n 1)
    if [[ "$VM_LINE" =~ ^(\{[0-9a-fA-F-]+\})[[:space:]]+([^[:space:]]+)[[:space:]]+(.*)$ ]]; then
      VM_UUID="${BASH_REMATCH[1]}"
      VM_STATUS="${BASH_REMATCH[2]}"
      VM_NAME="${BASH_REMATCH[3]}"
      break
    fi
  fi
  sleep 0.5
done

[[ -z "$VM_UUID" ]] && { err "No VM found or dispatcher timeout."; exit 1; }
ok "Target VM: $VM_NAME ($VM_UUID) [State: $VM_STATUS]"

# State transition guard
if [[ "$VM_STATUS" =~ ^(suspending|stopping)$ ]] && [[ "$MODE" =~ ^(latest|index|select)$ ]]; then
  as_user prlctl stop "$VM_UUID" --kill >/dev/null 2>&1
  sleep 0.5
  VM_STATUS=$(as_user prlctl list --no-header -o status "$VM_UUID" 2>/dev/null | tr -d '[:space:]')
else
  for (( i=0; i<15; i++ )); do
    [[ "$VM_STATUS" =~ ^(suspending|stopping|snapshotting)$ ]] || break
    sleep 0.5
    VM_STATUS=$(as_user prlctl list --no-header -o status "$VM_UUID" 2>/dev/null | tr -d '[:space:]')
  done
fi

# 12. Snapshot Selection & Revert
if [[ "$MODE" == "create" ]]; then
  info "Creating new snapshot '$SNAP_ARG'..."
  as_user prlctl snapshot "$VM_UUID" --name "$SNAP_ARG"
elif [[ "$MODE" != "none" ]]; then
  load_snapshots "$VM_UUID"
  if (( ${#SNAP_IDS[@]} > 0 )); then
    LATEST_IDX=$(( ${#SNAP_IDS[@]} - 1 ))
    TARGET_SNAP=""

    case "$MODE" in
      latest) TARGET_SNAP="${SNAP_IDS[$LATEST_IDX]}" ;;
      index)
        if (( SNAP_ARG > 0 && SNAP_ARG <= ${#SNAP_IDS[@]} )); then
          TARGET_SNAP="${SNAP_IDS[$((SNAP_ARG-1))]}"
        else
          err "Invalid snapshot #$SNAP_ARG (Valid: 1-${#SNAP_IDS[@]})."
          exit 1
        fi
        ;;
      select)
        print_snapshot_table
        read -r -p "Select snapshot [1-${#SNAP_IDS[@]}] (Enter = latest #$((LATEST_IDX+1)), 0 = skip): " s_choice
        if [[ -z "$s_choice" ]]; then
          TARGET_SNAP="${SNAP_IDS[$LATEST_IDX]}"
        elif [[ "$s_choice" =~ ^[0-9]+$ ]] && (( s_choice > 0 && s_choice <= ${#SNAP_IDS[@]} )); then
          TARGET_SNAP="${SNAP_IDS[$((s_choice-1))]}"
        fi
        ;;
    esac

    if [[ -n "$TARGET_SNAP" ]]; then
      info "Reverting to snapshot $TARGET_SNAP..."
      as_user prlctl snapshot-switch "$VM_UUID" --id "$TARGET_SNAP"
      sleep 0.8
    fi
  fi
fi

# 13. VM Ignition
for (( attempt=1; attempt<=5; attempt++ )); do
  VM_STATUS=$(as_user prlctl list --no-header -o status "$VM_UUID" 2>/dev/null | tr -d '[:space:]')
  case "$VM_STATUS" in
    running)
      ok "VM is running."
      break
      ;;
    suspended|paused)
      info "Resuming VM..."
      as_user prlctl resume "$VM_UUID" && break
      ;;
    stopped|poweroff)
      info "Starting VM..."
      as_user prlctl set "$VM_UUID" --time-sync off >/dev/null 2>&1
      as_user prlctl start "$VM_UUID" && break
      ;;
  esac
  sleep 1
done

# 14. Immediate Host Recovery & Background Guest Clock Injection
as_user open -a "Parallels Desktop" >/dev/null 2>&1
restore_time

info "Injecting real-time clock into Windows Guest..."
(
  nohup bash -c '
    VM_UUID="$1"; REAL_USER="$2"; REAL_UID="$3"
    as_u() { launchctl asuser "$REAL_UID" sudo -u "$REAL_USER" "$@"; }
    as_u prlctl set "$VM_UUID" --time-sync on >/dev/null 2>&1
    for (( i=0; i<15; i++ )); do
      ISO_NOW=$(date +"%Y-%m-%dT%H:%M:%S")
      if as_u prlctl exec "$VM_UUID" powershell.exe -NoProfile -WindowStyle Hidden -Command \
        "Set-Date -Date '\''$ISO_NOW'\''; Start-Service w32time -ErrorAction SilentlyContinue; w32tm /resync /force" >/dev/null 2>&1; then
        break
      fi
      sleep 1.5
    done
  ' _ "$VM_UUID" "$REAL_USER" "$REAL_UID" >/dev/null 2>&1 &
)
disown -a 2>/dev/null

ok "All done! VM '$VM_NAME' is active and clocks are synced."