#!/bin/bash

# Tùy chọn dòng lệnh:
#   (không tham số) : Khởi động/Resume thẳng VM (nhanh nhất)
#   -r [số]         : Revert về snapshot mới nhất (hoặc số thứ tự chỉ định, vd: pd-clean -r 1)
#   -s              : Hiện bảng danh sách chi tiết để chọn snapshot
MODE="none"
SNAP_ARG=""

case "$1" in
  -r|--revert)
    MODE="latest"
    [[ "$2" =~ ^[0-9]+$ ]] && { MODE="index"; SNAP_ARG="$2"; }
    ;;
  -s|--select)
    MODE="select"
    ;;
  -h|--help)
    echo "Usage: $(basename "$0") [-r [num] | -s]"
    echo "  (no args) : Start/Resume VM directly"
    echo "  -r [num]  : Revert to latest snapshot (or snapshot #num)"
    echo "  -s        : Select snapshot interactively"
    exit 0
    ;;
esac

# 1. Tự nâng quyền root 1 lần duy nhất và xóa cache sudo cũ
if (( EUID != 0 )); then
  clear
  echo "Please enter your macOS password once:"
  sudo -k
  exec sudo "$0" "$@"
fi

REAL_USER="${SUDO_USER:-$(stat -f '%Su' /dev/console)}"
REAL_UID=$(id -u "$REAL_USER")
PLIST="/var/root/Library/Preferences/com.parallels.desktop.plist"
EPOCH_CACHE="/var/root/.pd_real_epoch"

as_user() {
  launchctl asuser "$REAL_UID" sudo -u "$REAL_USER" "$@"
}

[[ -d "/Applications/Parallels Desktop.app" ]] || { echo "Parallels not installed."; exit 1; }

# Lấy Unix Timestamp qua HTTP Header bằng curl + BSD date thuần
fetch_network_epoch() {
  local hdr ts
  for url in "http://captive.apple.com" "https://1.1.1.1" "https://www.google.com"; do
    hdr=$(curl -skI --max-time 2 "$url" 2>/dev/null | awk 'tolower($1)=="date:" {sub(/^[^:]+:[[:space:]]*/, ""); sub(/\r$/, ""); print; exit}')
    if [[ -n "$hdr" ]]; then
      ts=$(LC_ALL=C date -juf "%a, %d %b %Y %H:%M:%S %Z" "$hdr" +%s 2>/dev/null)
      (( ts > 1700000000 )) && { echo "$ts"; return 0; }
    fi
  done
  return 1
}

# Khôi phục giờ thực tế cho macOS (Online & Offline)
restore_time() {
  local target_ts=$(( SAVED_EPOCH > 0 ? SAVED_EPOCH + SECONDS : 0 ))
  local net_ts

  if net_ts=$(fetch_network_epoch); then
    target_ts=$net_ts
  elif (( target_ts == 0 )) && [[ -f "$EPOCH_CACHE" ]]; then
    target_ts=$(( $(<"$EPOCH_CACHE") + SECONDS ))
  fi

  if (( target_ts > 1700000000 )); then
    date "$(date -r "$target_ts" "+%m%d%H%M%Y.%S")" >/dev/null 2>&1
    echo "$target_ts" > "$EPOCH_CACHE"
  fi

  systemsetup -setusingnetworktime on >/dev/null 2>&1
  killall -9 timed 2>/dev/null
  launchctl kickstart -k system/com.apple.timed 2>/dev/null
  rm -rf /var/db/sudo/ts/* 2>/dev/null

  echo "macOS time restored: $(date)"
}

trap 'echo ""; restore_time; exit 0' INT TERM

# 2. Đọc hoặc tự động tạo trường started_at trong plist
PLIST_CONTENT=$(plutil -p "$PLIST" 2>/dev/null)

if [[ "$PLIST_CONTENT" =~ \"started_at\"[[:space:]]*\=\>[[:space:]]*\"(202[0-9])-([0-9]{2})-([0-9]{2}) ]]; then
  YYYY="${BASH_REMATCH[1]}"; MM="${BASH_REMATCH[2]}"; DD="${BASH_REMATCH[3]}"
else
  if [[ "$PLIST_CONTENT" =~ (202[0-9])-([0-9]{2})-([0-9]{2}) ]]; then
    YYYY="${BASH_REMATCH[1]}"; MM="${BASH_REMATCH[2]}"; DD="${BASH_REMATCH[3]}"
  else
    YYYY="2026"; MM="11"; DD="10"
  fi
  DETECTED_DATE="${YYYY}-${MM}-${DD}"
  echo "Injecting started_at: $DETECTED_DATE"
  plutil -replace "started_at" -string "$DETECTED_DATE" "$PLIST" 2>/dev/null || \
  plutil -insert "started_at" -string "$DETECTED_DATE" "$PLIST" 2>/dev/null
fi

FAKE_YMD="${YYYY}${MM}${DD}"
MAC_DATE="${MM}${DD}0000${YYYY}"

# 3. Chốt mốc thời gian thực trước khi lùi giờ
if NET_NOW=$(fetch_network_epoch); then
  SAVED_EPOCH=$NET_NOW
  date "$(date -r "$SAVED_EPOCH" "+%m%d%H%M%Y.%S")" >/dev/null 2>&1
elif [[ "$(date +%Y%m%d)" != "$FAKE_YMD" ]]; then
  SAVED_EPOCH=$(date +%s)
elif [[ -f "$EPOCH_CACHE" ]]; then
  SAVED_EPOCH=$(<"$EPOCH_CACHE")
else
  SAVED_EPOCH=$(stat -f "%m" /var/log/system.log 2>/dev/null || date +%s)
fi

echo "$SAVED_EPOCH" > "$EPOCH_CACHE"
SECONDS=0

# 4. Đóng Parallels nếu đang chạy
if pgrep -f "Parallels Desktop|prl_client_app|prl_vm_app" >/dev/null; then
  read -r -p "Parallels is running. FORCE kill? (y/n): " ans
  [[ "$ans" =~ ^[Yy]$ ]] || exit 0
  killall "Parallels Desktop" prl_client_app prl_vm_app 2>/dev/null
  sleep 1
fi

# 5. Lùi giờ macOS và mở Parallels Desktop
echo "Setting macOS date to ${YYYY}-${MM}-${DD}..."
systemsetup -setusingnetworktime off >/dev/null 2>&1
date "$MAC_DATE" >/dev/null

echo "Starting Parallels Desktop..."
as_user open -a "Parallels Desktop"

# 6. Chờ dịch vụ sẵn sàng và lấy luôn UUID + Status + Name trong 1 lần gọi
VM_UUID=""
for (( i=0; i<30; i++ )); do
  if pgrep -f prl_client_app >/dev/null; then
    VM_LINE=$(as_user prlctl list -a --no-header -o uuid,status,name 2>/dev/null | head -n 1)
    if [[ "$VM_LINE" =~ ^(\{[0-9a-fA-F-]+\})[[:space:]]+([^[:space:]]+)[[:space:]]+(.*)$ ]]; then
      VM_UUID="${BASH_REMATCH[1]}"
      VM_STATUS="${BASH_REMATCH[2]}"
      VM_NAME="${BASH_REMATCH[3]}"
      break
    fi
  fi
  sleep 1
done

[[ -z "$VM_UUID" ]] && { echo "No VM found or service timeout."; restore_time; exit 1; }
echo "Selected VM: $VM_NAME ($VM_UUID)"

for (( i=0; i<15; i++ )); do
  [[ "$VM_STATUS" =~ ^(suspending|stopping|snapshotting)$ ]] || break
  echo "Waiting for VM state ($VM_STATUS)..."
  sleep 2
  VM_STATUS=$(as_user prlctl list --no-header -o status "$VM_UUID" 2>/dev/null | tr -d '[:space:]')
done

# 7. Xử lý Snapshot bằng cách đọc trực tiếp Snapshots.xml + prlctl snapshot-list
if [[ "$MODE" != "none" ]]; then
  VM_HOME=$(as_user prlctl list -i "$VM_UUID" 2>/dev/null | awk -F': ' '/^Home:/ {print $2; exit}')
  SNAP_XML="${VM_HOME%/}/Snapshots.xml"
  RAW_SNAP=$(as_user prlctl snapshot-list "$VM_UUID" 2>/dev/null)
  ACTIVE_SNAP=$(echo "$RAW_SNAP" | grep -oE '\*\{[0-9a-fA-F-]{36}\}' | tr -d '*')

  SNAP_IDS=()
  SNAP_LINES=()

  if [[ -f "$SNAP_XML" ]]; then
    while IFS='|' read -r sid scur sdate sstate sname sdesc; do
      [[ -z "$sid" ]] && continue
      SNAP_IDS+=("$sid")
      SNAP_LINES+=("$(printf "%-3s | %-24s | %-19s | %-9s | %s %s" "$scur" "$sname" "$sdate" "$sstate" "$sid" "${sdesc:+($sdesc)}")")
    done < <(python3 -c '
import xml.etree.ElementTree as ET, sys
try:
    root = ET.parse(sys.argv[1]).getroot()
    cur = (sys.argv[2] or root.attrib.get("CurrentSnapshot", "")).lower()
    for item in root.iter("SavedStateItem"):
        guid = item.attrib.get("guid", "")
        if not guid: continue
        name = (item.findtext("Name") or "Unnamed").strip()
        dt   = (item.findtext("DateTime") or "N/A").strip()
        st   = (item.findtext("VmState") or item.findtext("State") or item.attrib.get("state") or "saved").strip()
        desc = (item.findtext("Description") or "").strip().replace("\n", " ")
        mark = " * " if guid.lower() == cur else "   "
        print(f"{guid}|{mark}|{dt}|{st}|{name}|{desc}")
except Exception:
    pass
' "$SNAP_XML" "$ACTIVE_SNAP" 2>/dev/null)
  fi

  # Fallback nếu Snapshots.xml không đọc được thì lấy trực tiếp danh sách UUID từ prlctl snapshot-list
  if (( ${#SNAP_IDS[@]} == 0 )); then
    while IFS= read -r id; do
      [[ -z "$id" ]] && continue
      SNAP_IDS+=("$id")
      mark="   "
      [[ "$(echo "$id" | tr '[:upper:]' '[:lower:]')" == "$(echo "$ACTIVE_SNAP" | tr '[:upper:]' '[:lower:]')" ]] && mark=" * "
      SNAP_LINES+=("$(printf "%-3s | %-24s | %-19s | %-9s | %s" "$mark" "Snapshot" "N/A" "saved" "$id")")
    done < <(echo "$RAW_SNAP" | grep -oE '\{[0-9a-fA-F-]{36}\}')
  fi

  if (( ${#SNAP_IDS[@]} == 0 )); then
    echo "No snapshots found. Continuing normal startup..."
  else
    LATEST_IDX=$(( ${#SNAP_IDS[@]} - 1 ))
    TARGET_SNAP=""

    case "$MODE" in
      latest)
        TARGET_SNAP="${SNAP_IDS[$LATEST_IDX]}"
        ;;
      index)
        if (( SNAP_ARG > 0 && SNAP_ARG <= ${#SNAP_IDS[@]} )); then
          TARGET_SNAP="${SNAP_IDS[$((SNAP_ARG-1))]}"
        else
          echo "Invalid snapshot #$SNAP_ARG (Valid: 1-${#SNAP_IDS[@]})."
          restore_time; exit 1
        fi
        ;;
      select)
        echo ""
        echo "===================================================================================================="
        printf " %-4s | %-3s | %-24s | %-19s | %-9s | %s\n" "No." "Cur" "Snapshot Name" "Created Date" "State" "Snapshot UUID / Description"
        echo "----------------------------------------------------------------------------------------------------"
        for idx in "${!SNAP_IDS[@]}"; do
          printf " [%2d] | %s\n" "$((idx+1))" "${SNAP_LINES[$idx]}"
        done
        echo "===================================================================================================="
        read -r -p "Select snapshot [1-${#SNAP_IDS[@]}] (Enter = latest #$((LATEST_IDX+1)), 0 = skip): " s_choice
        if [[ -z "$s_choice" ]]; then
          TARGET_SNAP="${SNAP_IDS[$LATEST_IDX]}"
        elif [[ "$s_choice" =~ ^[0-9]+$ ]] && (( s_choice > 0 && s_choice <= ${#SNAP_IDS[@]} )); then
          TARGET_SNAP="${SNAP_IDS[$((s_choice-1))]}"
        fi
        ;;
    esac

    if [[ -n "$TARGET_SNAP" ]]; then
      echo "Reverting to snapshot $TARGET_SNAP..."
      as_user prlctl snapshot-switch "$VM_UUID" --id "$TARGET_SNAP"
      VM_STATUS=$(as_user prlctl list --no-header -o status "$VM_UUID" 2>/dev/null | tr -d '[:space:]')
    fi
  fi
fi

# 8. Khởi động hoặc Resume VM
[[ "$VM_STATUS" == "stopped" ]] && as_user prlctl set "$VM_UUID" --time-sync off >/dev/null 2>&1

case "$VM_STATUS" in
  running)          echo "VM is already running." ;;
  suspended|paused) as_user prlctl resume "$VM_UUID" ;;
  *)                as_user prlctl start "$VM_UUID" 2>/dev/null || as_user prlctl resume "$VM_UUID" ;;
esac

# 9. Khôi phục giờ thực tế cho macOS ngay lập tức
restore_time

# 10. Đồng bộ giờ thực sang Windows VM (tự tính bù độ trễ cho mỗi vòng lặp chờ)
echo "Syncing real time into Windows VM..."
(
  as_user prlctl set "$VM_UUID" --time-sync on >/dev/null 2>&1
  for (( i=0; i<12; i++ )); do
    ISO_NOW=$(date +"%Y-%m-%dT%H:%M:%S")
    if as_user prlctl exec "$VM_UUID" powershell.exe -NoProfile -WindowStyle Hidden -Command \
      "Set-Date -Date '$ISO_NOW'; Start-Service w32time -ErrorAction SilentlyContinue; w32tm /resync /force" >/dev/null 2>&1; then
      break
    fi
    sleep 2
  done
) &

echo "Done! Both macOS and VM '$VM_NAME' are synced to real time."