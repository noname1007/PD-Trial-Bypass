#!/bin/bash
# PD-CLEAN: Parallels Desktop Trial Time-Bypass, Launcher & Snapshot Manager

VERSION="3.3.0"
PLIST="/var/root/Library/Preferences/com.parallels.desktop.plist"
EPOCH_CACHE="/var/root/.pd_real_epoch"
GUARD_PID_FILE="/var/root/.pd_guard_pid"
LOCK_DIR="/tmp/pd-clean-${UID}.lock"
VMSYNC_PID_FILE="/tmp/pd-clean-vmsync-${UID}.pid"
PARALLELS_APP="/Applications/Parallels Desktop.app"
DATE_REGEX='^(20[2-9][0-9])-([0-9]{2})-([0-9]{2})$'
TRANS_REGEX='^(suspending|stopping|snapshotting|reverting|starting|resuming)$'

if [[ "$0" == */* ]]; then
  SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
else
  SCRIPT_PATH="$(command -v "$0" 2>/dev/null || echo "$0")"
fi

R=$'\033[0;31m'; G=$'\033[0;32m'; Y=$'\033[1;33m'; B=$'\033[0;34m'; C=$'\033[0;36m'; N=$'\033[0m'
info() { echo "${B}[INFO]${N} $*"; }
ok()   { echo "${G}[ OK ]${N} $*"; }
warn() { echo "${Y}[WARN]${N} $*"; }
err()  { echo "${R}[ERR ]${N} $*" >&2; }
die()  { err "$*"; exit 1; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
need_root() { (( EUID == 0 )) || die "Root required."; }
vm_status() { prlctl list -a --no-header -o status "$1" 2>/dev/null | tr -d '[:space:]'; }
parallels_running() { pgrep -x prl_client_app >/dev/null 2>&1 || pgrep -x prl_vm_app >/dev/null 2>&1; }

is_valid_date() {
  [[ "$1" =~ $DATE_REGEX ]] && [[ "$(LC_ALL=C date -jf "%Y-%m-%d" "$1" "+%Y-%m-%d" 2>/dev/null)" == "$1" ]]
}

mono_now() {
  /usr/bin/perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC -e 'print int(clock_gettime(CLOCK_MONOTONIC))' 2>/dev/null
}

spawn_detached() {
  /usr/bin/perl -MPOSIX=setsid -e '
    my $p = fork(); exit 1 unless defined $p; exit 0 if $p > 0;
    setsid() or exit 1;
    open STDIN, "<", "/dev/null"; open STDOUT, ">", "/dev/null"; open STDERR, ">", "/dev/null";
    exec @ARGV; exit 127;
  ' "$@"
}

run_with_timeout() {
  /usr/bin/perl -e '
    my $t = shift @ARGV; my $p = fork(); exit 1 unless defined $p;
    if ($p == 0) { open STDOUT, ">", "/dev/null"; open STDERR, ">", "/dev/null"; exec @ARGV; exit 127; }
    my $to = 0;
    local $SIG{ALRM} = sub { $to = 1; kill "TERM", $p; select(undef,undef,undef,0.2); kill "KILL", $p; };
    alarm($t); waitpid($p, 0); alarm(0);
    exit($to ? 124 : ($? >> 8));
  ' "$@"
}

fetch_network_epoch() {
  local hdr ts url
  for url in "http://captive.apple.com" "https://1.1.1.1" "https://www.google.com"; do
    hdr=$(curl -skI --connect-timeout 1 --max-time 2 "$url" 2>/dev/null | \
      awk 'tolower($1)=="date:" {sub(/^[^:]+:[[:space:]]*/, ""); sub(/\r$/, ""); print; exit}')
    [[ -n "$hdr" ]] || continue
    ts=$(LC_ALL=C date -juf "%a, %d %b %Y %H:%M:%S %Z" "$hdr" +%s 2>/dev/null)
    [[ "$ts" =~ ^[0-9]+$ ]] && (( ts > 1700000000 )) && { echo "$ts"; return 0; }
  done
  return 1
}

read_cached_epoch() {
  [[ -f "$EPOCH_CACHE" ]] || return 1
  local raw; raw=$(tr -d '[:space:]' < "$EPOCH_CACHE" 2>/dev/null)
  [[ "$raw" =~ ^[0-9]+$ ]] && (( raw > 1700000000 )) && echo "$raw"
}

write_cached_epoch() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( $1 > 1700000000 )) || return 1
  printf '%s\n' "$1" > "${EPOCH_CACHE}.tmp" 2>/dev/null && mv -f "${EPOCH_CACHE}.tmp" "$EPOCH_CACHE" 2>/dev/null
}

is_active_guard() {
  [[ ! -f "$GUARD_PID_FILE" ]] || [[ "$(tr -d '[:space:]' < "$GUARD_PID_FILE" 2>/dev/null)" == "$$" ]]
}

reenable_ntp_and_cleanup() {
  local real_user="${1:-}" check_guard="${2:-0}"
  (( check_guard == 1 )) && ! is_active_guard && return 0
  systemsetup -setusingnetworktime on >/dev/null 2>&1
  (( check_guard == 1 )) && ! is_active_guard && return 0
  launchctl kickstart -k system/com.apple.timed >/dev/null 2>&1
  (sntp -sS time.apple.com >/dev/null 2>&1 &)
  [[ -n "$real_user" && "$real_user" != "root" && "$real_user" =~ ^[a-zA-Z0-9._-]+$ ]] && \
    rm -f "/var/db/sudo/ts/$real_user" 2>/dev/null
}

stop_vmsync_daemon() {
  [[ -f "$VMSYNC_PID_FILE" ]] || return 0
  local pid; pid=$(tr -d '[:space:]' < "$VMSYNC_PID_FILE" 2>/dev/null)
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -TERM "$pid" 2>/dev/null
  rm -f "$VMSYNC_PID_FILE" 2>/dev/null
}

sync_guest_clock_once() {
  local vm_id="$1" vm_os="${2:-}" tout="${3:-5}" now_epoch mac_utc ps_cmd sh_cmd
  now_epoch=$(date +%s 2>/dev/null)
  [[ "$now_epoch" =~ ^[0-9]+$ ]] && (( now_epoch > 1700000000 )) || return 1
  mac_utc=$(date -u -r "$now_epoch" "+%m%d%H%M%Y.%S" 2>/dev/null) || return 1
  ps_cmd="\$ErrorActionPreference='Stop'; Set-Date ((New-Object DateTime 1970,1,1,0,0,0,([DateTimeKind]::Utc)).AddSeconds(${now_epoch}).ToLocalTime()); \$ErrorActionPreference='SilentlyContinue'; w32tm /resync /force 2>\$null | Out-Null; exit 0"
  sh_cmd="date -u -s '@${now_epoch}' >/dev/null 2>&1 || date -u '${mac_utc}' >/dev/null 2>&1"

  case "$vm_os" in
    *win*) run_with_timeout "$tout" prlctl exec "$vm_id" powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ps_cmd" ;;
    *mac*|*osx*|*darwin*) run_with_timeout "$tout" prlctl exec "$vm_id" date -u "$mac_utc" ;;
    "") run_with_timeout "$tout" prlctl exec "$vm_id" /bin/sh -c "$sh_cmd" || \
        run_with_timeout "$tout" prlctl exec "$vm_id" powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ps_cmd" ;;
    *) run_with_timeout "$tout" prlctl exec "$vm_id" /bin/sh -c "$sh_cmd" ;;
  esac
}

# ==============================================================================
# Internal Helpers (Root helpers run via `sudo "$SCRIPT_PATH" --_...` -> 0 prompts!)
# ==============================================================================
case "${1:-}" in
  --_ping) (( EUID == 0 )) || exit 1; exit 0 ;;

  --_extract-date)
    need_root
    plist_dump=$(plutil -p "$PLIST" 2>/dev/null)
    extracted=$(printf '%s\n' "$plist_dump" | tr ',' '\n' | \
      grep -oE '\\?"started_at\\?"[[:space:]]*:[[:space:]]*\\?"20[2-9][0-9]-[0-9]{2}-[0-9]{2}' | \
      head -n 1 | grep -oE '20[2-9][0-9]-[0-9]{2}-[0-9]{2}')
    is_valid_date "$extracted" || \
      extracted=$(printf '%s\n' "$plist_dump" | tr ',' '\n' | grep -E '"started_at\\?"' | \
        head -n 1 | grep -oE '20[2-9][0-9]-[0-9]{2}-[0-9]{2}')
    is_valid_date "$extracted" || exit 1
    printf '%s\n' "$extracted"; exit 0 ;;

  --_fix-time)
    need_root; trap '' INT TERM HUP QUIT
    target_ts=0
    if cached_ep=$(read_cached_epoch); then
      target_ts=$cached_ep
      date "$(date -r "$target_ts" "+%m%d%H%M%Y.%S")" >/dev/null 2>&1
    fi
    if net_ts=$(fetch_network_epoch); then
      target_ts=$net_ts
      date "$(date -r "$target_ts" "+%m%d%H%M%Y.%S")" >/dev/null 2>&1
    fi
    (( target_ts > 1700000000 )) && write_cached_epoch "$target_ts"
    reenable_ntp_and_cleanup "${2:-}" 0
    printf 'RESTORED:%s\n' "$(date)"; exit 0 ;;

  --_time-guard)
    need_root
    [[ "${2:-}" =~ ^[0-9]+$ ]] || exit 1
    [[ "${3:-}" =~ ^/tmp/pd-clean-guard\.[A-Za-z0-9]+$ && -d "${3:-}" && ! -L "${3:-}" ]] || exit 1
    [[ "${4:-}" =~ ^[0-9]{12}$ && "${5:-}" =~ ^20[2-9][0-9]{5}$ ]] || exit 1
    [[ -z "${6:-}" || "${6:-}" =~ ^[a-zA-Z0-9._-]+$ ]] || exit 1
    spawn_detached "$SCRIPT_PATH" --_time-guard-daemon "$2" "$3" "$4" "$5" "${6:-}"; exit $? ;;

  --_time-guard-daemon)
    (( EUID == 0 )) || exit 1; trap '' INT HUP TERM QUIT
    parent_pid="$2"; guard_dir="$3"; mac_date="$4"; fake_ymd="$5"; real_user="${6:-}"
    printf '%s\n' "$$" > "$GUARD_PID_FILE" 2>/dev/null

    # Fast-path: use local clock immediately (~2ms) unless already spoofed/stale!
    local_now=$(date +%s 2>/dev/null || echo 0)
    cached_ep=$(read_cached_epoch 2>/dev/null || echo 0)
    if [[ "$(date +%Y%m%d 2>/dev/null)" != "$fake_ymd" ]] && (( local_now > 1700000000 && local_now + 3600 >= cached_ep )); then
      saved_epoch=$local_now
    elif net_now=$(fetch_network_epoch); then
      saved_epoch=$net_now
    elif (( cached_ep > local_now && cached_ep > 1700000000 )); then
      saved_epoch=$cached_ep
    elif (( local_now > 1700000000 )); then
      saved_epoch=$local_now
    else
      saved_epoch=$(stat -f "%m" /var/log/system.log 2>/dev/null || date +%s)
    fi

    mono_start=$(mono_now); [[ "$mono_start" =~ ^[0-9]+$ ]] || mono_start=0
    write_cached_epoch "$saved_epoch"

    systemsetup -setusingnetworktime off >/dev/null 2>&1
    date "$mac_date" >/dev/null 2>&1 && st="OK" || st="ERR"
    printf '%s\n' "$st" > "$guard_dir/ready.tmp" && mv -f "$guard_dir/ready.tmp" "$guard_dir/ready"
    chmod 644 "$guard_dir/ready" 2>/dev/null

    while [[ ! -f "$guard_dir/restore" ]] && kill -0 "$parent_pid" 2>/dev/null; do sleep 0.2; done

    # Step 1 (Instant, ~5ms): Restore exact CLOCK_MONOTONIC real time & signal parent immediately!
    mono_end=$(mono_now); elapsed=0
    [[ "$mono_end" =~ ^[0-9]+$ ]] && (( mono_start > 0 && mono_end >= mono_start )) && elapsed=$(( mono_end - mono_start ))
    target_ts=0
    if (( saved_epoch > 1700000000 )); then
      target_ts=$(( saved_epoch + elapsed ))
      date "$(date -r "$target_ts" "+%m%d%H%M%Y.%S")" >/dev/null 2>&1
      write_cached_epoch "$target_ts"
    fi

    if [[ -d "$guard_dir" ]]; then
      printf 'DONE:%s\n' "$(date)" > "$guard_dir/done.tmp" && mv -f "$guard_dir/done.tmp" "$guard_dir/done"
      chmod 644 "$guard_dir/done" 2>/dev/null
    fi

    # Step 2 (Background, non-blocking): Refine via network + re-enable NTP (only if no newer run started!)
    if is_active_guard && net_ts=$(fetch_network_epoch); then
      if is_active_guard; then
        diff=$(( net_ts - target_ts )); (( diff < 0 )) && diff=$(( -diff ))
        (( target_ts == 0 || diff >= 2 )) && date "$(date -r "$net_ts" "+%m%d%H%M%Y.%S")" >/dev/null 2>&1
        (( net_ts >= saved_epoch )) && write_cached_epoch "$net_ts"
      fi
    fi
    reenable_ntp_and_cleanup "$real_user" 1

    if ! kill -0 "$parent_pid" 2>/dev/null; then sleep 0.5; rm -rf "$guard_dir" 2>/dev/null; fi
    exit 0 ;;

  --_vm-time-sync-daemon)
    trap '' INT HUP QUIT
    trap 'rm -f "$VMSYNC_PID_FILE" 2>/dev/null; exit 0' TERM
    vm_id="${2:-}"; vm_os="${3:-}"
    [[ -n "$vm_id" ]] || exit 0
    printf '%s\n' "$$" > "$VMSYNC_PID_FILE" 2>/dev/null

    for (( i=1; i<=22; i++ )); do
      (( i == 1 )) && sleep 3 || sleep 4
      # Abort immediately if another pd-clean run acquired lock (could be spoofing clock!)
      [[ -d "$LOCK_DIR" ]] && break
      [[ "$(vm_status "$vm_id")" == "running" ]] || break
      sync_guest_clock_once "$vm_id" "$vm_os" 12 && break
    done
    rm -f "$VMSYNC_PID_FILE" 2>/dev/null
    exit 0 ;;
esac

# ==============================================================================
# Normal User CLI
# ==============================================================================
show_help() {
  cat <<EOF
${C}PD-CLEAN v${VERSION}${N} - Parallels Desktop Bypass & Snapshot Tool

${Y}Usage:${N} $(basename "$0") [options]

${Y}Options:${N}
  (no args)            Start/Resume VM with time-bypass, restore macOS time & sync VM time
  --wait               Wait until Parallels closes before restoring macOS time
  --no-wait            Restore macOS time immediately after VM starts (default)
  -r [num]             Revert to latest snapshot (or snapshot #<num>) before starting
  -s, --select         Show interactive snapshot table to select and revert
  -l, --list           List all snapshots without starting/modifying time
  -c, --create [name]  Create a new snapshot before starting
  -x, --delete [num]   Delete snapshot interactively, by #<num>, or 'all' (and exit)
  -d, --date <date>    Override bypass date (format: YYYY-MM-DD, read-only on plist)
  -v, --vm <name|uuid> Target a specific VM by name or UUID
  -k, --kill           Cleanly stop all running Parallels VMs/processes and exit
  -f, --fix-time       Force restore macOS real-time clock immediately and exit
  -y, --yes            Skip confirmation prompts
  --install            Install globally to /usr/local/bin/pd-clean (with NOPASSWD sudoers)
  -h, --help           Show this help message
EOF
  exit 0
}

MODE="none"; SNAP_ARG=""; CUSTOM_DATE=""; TARGET_VM_QUERY=""; FORCE_YES=0; WAIT_FOR_EXIT=0
while (( $# > 0 )); do
  case "$1" in
    -r|--revert)
      MODE="latest"
      if [[ -n "${2:-}" && "${2:-}" != -* ]]; then
        [[ "$2" =~ ^[0-9]+$ ]] && (( 10#$2 > 0 )) || die "Invalid snapshot number for $1: '$2' (must be >= 1)."
        MODE="index"; SNAP_ARG="$((10#$2))"; shift
      fi ;;
    -s|--select)   MODE="select" ;;
    -l|--list)     MODE="list_only" ;;
    -c|--create)
      MODE="create"
      if [[ -n "${2:-}" && "${2:-}" != -* ]]; then SNAP_ARG="$2"; shift
      else SNAP_ARG="AutoSnap_$(date +%Y%m%d_%H%M)"; fi ;;
    -x|--delete|--rm)
      MODE="delete"
      [[ -n "${2:-}" && "${2:-}" != -* ]] && { SNAP_ARG="$2"; shift; } ;;
    -d|--date)
      [[ -n "${2:-}" && "${2:-}" != -* ]] || die "Option $1 requires a date (YYYY-MM-DD)."
      is_valid_date "$2" || die "Invalid date '$2' (expected valid YYYY-MM-DD)."
      CUSTOM_DATE="$2"; shift ;;
    -v|--vm)
      [[ -n "${2:-}" && "${2:-}" != -* ]] || die "Option $1 requires a VM name or UUID."
      TARGET_VM_QUERY="$2"; shift ;;
    --wait)        WAIT_FOR_EXIT=1 ;;
    --no-wait)     WAIT_FOR_EXIT=0 ;;
    -k|--kill)     MODE="kill_only" ;;
    -f|--fix-time) MODE="fix_time_only" ;;
    --install)     MODE="install" ;;
    -y|--yes)      FORCE_YES=1 ;;
    -h|--help)     show_help ;;
    *)             err "Unknown option: $1"; show_help ;;
  esac
  shift
done

run_priv() { if (( EUID == 0 )); then "$@"; else sudo "$@"; fi; }

if [[ "$MODE" == "install" ]]; then
  u="${SUDO_USER:-$USER}"
  [[ -z "$u" || "$u" == "root" ]] && u=$(stat -f '%Su' /dev/console 2>/dev/null || echo "")
  run_priv mkdir -p /usr/local/bin
  tmp=$(mktemp /tmp/pd-clean-inst.XXXXXX)
  LC_ALL=C sed 's/\xc2\xa0/ /g' "$SCRIPT_PATH" > "$tmp"
  run_priv cp -f "$tmp" /usr/local/bin/pd-clean; rm -f "$tmp"
  run_priv chown root:wheel /usr/local/bin/pd-clean
  run_priv chmod 755 /usr/local/bin/pd-clean
  [[ -d "/opt/homebrew/bin" ]] && run_priv ln -sf /usr/local/bin/pd-clean /opt/homebrew/bin/pd-clean
  if [[ -n "$u" && "$u" != "root" && "$u" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    tmp=$(mktemp /tmp/pd-clean-sudo.XXXXXX)
    printf '%s ALL=(root) NOPASSWD: /usr/local/bin/pd-clean, /opt/homebrew/bin/pd-clean\n' "$u" > "$tmp"
    run_priv cp -f "$tmp" /etc/sudoers.d/pd-clean; rm -f "$tmp"
    run_priv chown root:wheel /etc/sudoers.d/pd-clean
    run_priv chmod 0440 /etc/sudoers.d/pd-clean
    run_priv visudo -cf /etc/sudoers.d/pd-clean >/dev/null 2>&1 || run_priv rm -f /etc/sudoers.d/pd-clean
  fi
  ok "Installed successfully to /usr/local/bin/pd-clean (v${VERSION})"; exit 0
fi

run_root_helper() { run_priv "$SCRIPT_PATH" "$@"; }

ensure_root_auth() {
  (( EUID == 0 )) && return 0
  sudo -n "$SCRIPT_PATH" --_ping >/dev/null 2>&1 && return 0
  info "Authenticating sudo (run 'pd-clean --install' once to remove password prompt)..."
  sudo -v || die "sudo authentication failed."
}

if [[ "$MODE" == "fix_time_only" ]]; then
  ensure_root_auth
  out=$(run_root_helper --_fix-time "${SUDO_USER:-$USER}")
  ok "macOS time restored: ${out#RESTORED:}"; exit 0
fi

(( EUID == 0 )) && die "Do NOT run this script as root. Run normally: $(basename "$0")"
[[ -d "$PARALLELS_APP" ]] || die "Parallels Desktop not installed."

# ==============================================================================
# Core Runtime Helpers, Lock, Time-Guard & Cleanup
# ==============================================================================
GUARD_DIR=""; GUARD_ACTIVE=0; LOCK_ACQUIRED=0; INTERRUPTED=0; TIME_SYNC_DISABLED_VM=""
VM_LAUNCH_TYPE=""

wait_proc_exit() {
  local i; for (( i=0; i<$2; i++ )); do pgrep -x "$1" >/dev/null 2>&1 || return 0; sleep 0.3; done; return 1
}

wait_file() {
  local i; for (( i=0; i<$2; i++ )); do [[ -f "$1" ]] && return 0; sleep "$3"; done; return 1
}

wait_for_vm_settled() {
  local i st=""
  for (( i=0; i<${2:-60}; i++ )); do
    st=$(vm_status "$1")
    [[ "$st" =~ $TRANS_REGEX ]] && sleep 0.4 || { echo "$st"; return 0; }
  done
  echo "$st"; return 1
}

any_vm_busy() {
  prlctl list -a --no-header -o status 2>/dev/null | grep -qE "$TRANS_REGEX"
}

stop_parallels_cleanly() {
  local fast_kill="${1:-0}" line uuid st
  parallels_running || return 0

  if pgrep -x prl_vm_app >/dev/null 2>&1; then
    while IFS= read -r line; do
      [[ "$line" =~ ^(\{[0-9a-fA-F-]+\})[[:space:]]+([^[:space:]]+) ]] || continue
      uuid="${BASH_REMATCH[1]}"; st="${BASH_REMATCH[2]}"
      [[ "$st" =~ $TRANS_REGEX ]] && { info "Waiting for VM $uuid ($st)..."; st=$(wait_for_vm_settled "$uuid" 120); }
      if [[ "$st" == "running" || "$st" == "paused" ]]; then
        if (( fast_kill == 1 )); then
          info "Stopping VM $uuid before snapshot revert..."
          prlctl stop "$uuid" --kill >/dev/null 2>&1 || prlctl stop "$uuid" >/dev/null 2>&1
        else
          info "Suspending VM $uuid cleanly..."
          if ! prlctl suspend "$uuid" >/dev/null 2>&1; then
            st=$(vm_status "$uuid")
            [[ "$st" =~ $TRANS_REGEX ]] || prlctl stop "$uuid" >/dev/null 2>&1 || prlctl stop "$uuid" --kill >/dev/null 2>&1
          fi
        fi
        wait_for_vm_settled "$uuid" 120 >/dev/null
      fi
    done <<< "$(prlctl list -a --no-header -o uuid,status 2>/dev/null)"

    # Wait up to 60s for prl_vm_app to flush RAM/disk; NEVER SIGKILL while VM is still saving!
    if ! wait_proc_exit prl_vm_app 200; then
      if ! any_vm_busy; then
        warn "prl_vm_app still lingering; sending SIGTERM..."
        killall -TERM prl_vm_app 2>/dev/null
        wait_proc_exit prl_vm_app 30 || { ! any_vm_busy && killall -KILL prl_vm_app 2>/dev/null; }
      else
        warn "VM is still flushing disk/RAM; waiting to avoid corruption..."
        wait_proc_exit prl_vm_app 100
      fi
    fi
  fi

  if pgrep -x prl_client_app >/dev/null 2>&1; then
    osascript -e 'tell application "Parallels Desktop" to quit' >/dev/null 2>&1
    if ! wait_proc_exit prl_client_app 30; then
      killall -TERM prl_client_app 2>/dev/null
      wait_proc_exit prl_client_app 15 || killall -KILL prl_client_app 2>/dev/null
    fi
  fi
  sleep 0.5
}

start_time_guard() {
  stop_vmsync_daemon
  GUARD_DIR=$(mktemp -d /tmp/pd-clean-guard.XXXXXX); chmod 755 "$GUARD_DIR"
  GUARD_ACTIVE=1
  if ! run_root_helper --_time-guard "$$" "$GUARD_DIR" "$1" "$2" "$USER"; then
    GUARD_ACTIVE=0; rm -rf "$GUARD_DIR" 2>/dev/null
    err "Failed to start privileged time-guard watchdog."; return 1
  fi
  local st=""
  wait_file "$GUARD_DIR/ready" 150 0.1 && st=$(tr -d '[:space:]' < "$GUARD_DIR/ready" 2>/dev/null)
  [[ "$st" == "OK" ]] || { err "Failed to spoof system clock (date=$1)."; return 1; }
}

stop_time_guard() {
  (( GUARD_ACTIVE == 1 )) || return 0
  GUARD_ACTIVE=0
  [[ -n "$GUARD_DIR" && -d "$GUARD_DIR" ]] || return 0
  touch "$GUARD_DIR/restore" 2>/dev/null
  local done_msg=""
  wait_file "$GUARD_DIR/done" 100 0.1 && done_msg=$(cat "$GUARD_DIR/done" 2>/dev/null)
  rm -rf "$GUARD_DIR" 2>/dev/null
  [[ -n "$done_msg" ]] && ok "macOS time restored: ${done_msg#DONE:}" || ok "macOS time restored: $(date)"
}

sync_vm_time() {
  local vm_id="$1" launch_type="${2:-resume}" vm_os
  [[ -n "$vm_id" ]] || return 0
  stop_vmsync_daemon

  # Only touch config.pvs (--time-sync on) if we disabled it before cold boot
  if [[ "$TIME_SYNC_DISABLED_VM" == "$vm_id" ]]; then
    prlctl set "$vm_id" --time-sync on --time-sync-smart-mode off >/dev/null 2>&1 || \
      prlctl set "$vm_id" --time-sync on >/dev/null 2>&1 || true
    TIME_SYNC_DISABLED_VM=""
  fi

  vm_os=$(prlctl list -i "$vm_id" 2>/dev/null | awk -F': ' '/^[[:space:]]*OS:/ {print tolower($2); exit}')

  # Cold-booting VM won't have Parallels Tools up yet -> detach immediately (0s delay!)
  if [[ "$launch_type" == "start" ]]; then
    spawn_detached "$SCRIPT_PATH" --_vm-time-sync-daemon "$vm_id" "$vm_os" 2>/dev/null
    ok "VM time-sync enabled (guest clock will sync automatically once OS boots)."
    return 0
  fi

  # Resumed/running VM: push exact host time immediately via Parallels Tools (~0.2s)
  if sync_guest_clock_once "$vm_id" "$vm_os"; then
    ok "VM time synchronized with macOS."
  else
    prlctl set "$vm_id" --time-sync on >/dev/null 2>&1 || true
    spawn_detached "$SCRIPT_PATH" --_vm-time-sync-daemon "$vm_id" "$vm_os" 2>/dev/null
    ok "VM time-sync enabled (guest clock will sync automatically when Tools is ready)."
  fi
}

cleanup_on_exit() {
  local rc=$?
  trap '' INT TERM HUP QUIT
  (( INTERRUPTED == 1 )) && { echo ""; info "Interrupt received — keeping VM running and restoring macOS time..."; }
  stop_time_guard
  if [[ -n "$TIME_SYNC_DISABLED_VM" ]]; then
    local ts_vm="$TIME_SYNC_DISABLED_VM"; TIME_SYNC_DISABLED_VM=""
    if [[ "$(vm_status "$ts_vm")" == "running" ]]; then
      prlctl set "$ts_vm" --time-sync on >/dev/null 2>&1 || true
      sync_vm_time "$ts_vm" "${VM_LAUNCH_TYPE:-resume}"
    else
      prlctl set "$ts_vm" --time-sync on >/dev/null 2>&1 || true
    fi
  fi
  (( LOCK_ACQUIRED == 1 )) && rm -rf "$LOCK_DIR" 2>/dev/null
  exit "$rc"
}
trap 'cleanup_on_exit' EXIT
trap 'INTERRUPTED=1; exit 130' INT
trap 'INTERRUPTED=1; exit 143' TERM HUP QUIT

acquire_lock() {
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local old_pid=""
    [[ -f "$LOCK_DIR/pid" ]] && old_pid=$(tr -d '[:space:]' < "$LOCK_DIR/pid" 2>/dev/null)
    [[ "$old_pid" =~ ^[0-9]+$ ]] && kill -0 "$old_pid" 2>/dev/null && die "Another pd-clean instance (PID $old_pid) is already running."
    rm -rf "$LOCK_DIR" 2>/dev/null; mkdir "$LOCK_DIR" 2>/dev/null || die "Unable to acquire lock ($LOCK_DIR)."
  fi
  printf '%s\n' "$$" > "$LOCK_DIR/pid"; LOCK_ACQUIRED=1
}

resolve_target_vm() {
  VM_UUID=""; VM_STATUS=""; VM_NAME=""
  local line uuid st name q="" f_u="" f_s="" f_n="" a_u="" a_s="" a_n="" u_l u_b
  [[ -n "$TARGET_VM_QUERY" ]] && q=$(lower "$TARGET_VM_QUERY")
  while IFS= read -r line; do
    [[ "$line" =~ ^(\{[0-9a-fA-F-]+\})[[:space:]]+([^[:space:]]+)[[:space:]]+(.*)$ ]] || continue
    uuid="${BASH_REMATCH[1]}"; st="${BASH_REMATCH[2]}"; name="${BASH_REMATCH[3]}"
    name="${name%"${name##*[![:space:]]}"}"
    if [[ -n "$q" ]]; then
      u_l=$(lower "$uuid"); u_b="${u_l#\{}"; u_b="${u_b%\}}"
      if [[ "$u_l" == "$q" || "$u_b" == "$q" || "$(lower "$name")" == "$q" ]]; then
        VM_UUID="$uuid"; VM_STATUS="$st"; VM_NAME="$name"; return 0
      fi
      continue
    fi
    [[ -z "$f_u" ]] && { f_u="$uuid"; f_s="$st"; f_n="$name"; }
    [[ -z "$a_u" && "$st" =~ ^(running|paused|suspended|suspending|resuming)$ ]] && { a_u="$uuid"; a_s="$st"; a_n="$name"; }
  done <<< "$(prlctl list -a --no-header -o uuid,status,name 2>/dev/null)"
  [[ -n "$q" ]] && return 1
  if [[ -n "$a_u" ]]; then VM_UUID="$a_u"; VM_STATUS="$a_s"; VM_NAME="$a_n"; return 0
  elif [[ -n "$f_u" ]]; then VM_UUID="$f_u"; VM_STATUS="$f_s"; VM_NAME="$f_n"; return 0; fi
  return 1
}

can_use_python3() {
  local py; py=$(command -v python3 2>/dev/null) || return 1
  [[ "$py" != "/usr/bin/python3" ]] || xcode-select -p >/dev/null 2>&1
}

load_snapshots() {
  local vm_id="$1" vm_home snap_xml raw_snap active_snap rc attempt sid scur sdate sstate sname sdesc id mark
  [[ -n "$vm_id" ]] || return 1
  for (( attempt=1; attempt<=3; attempt++ )); do
    SNAP_IDS=(); SNAP_LINES=()
    vm_home=$(prlctl list -i "$vm_id" 2>/dev/null | awk -F': ' '/^Home:/ {print $2; exit}')
    snap_xml="${vm_home:+${vm_home%/}/Snapshots.xml}"
    [[ -n "$snap_xml" ]] || snap_xml=$(find "$HOME/Parallels" "/Users/Shared/Parallels" -maxdepth 3 -name "Snapshots.xml" 2>/dev/null | head -n 1)
    raw_snap=$(prlctl snapshot-list "$vm_id" 2>/dev/null); rc=$?
    active_snap=$(printf '%s\n' "$raw_snap" | grep -oE '\*\{[0-9a-fA-F-]{36}\}' | head -n 1 | tr -d '*')

    if [[ -f "$snap_xml" ]] && can_use_python3; then
      while IFS=$'\x1f' read -r sid scur sdate sstate sname sdesc; do
        [[ -z "$sid" ]] && continue
        SNAP_IDS+=("$sid")
        SNAP_LINES+=("$(printf "%-3s | %-14.14s | %-19s | %-8s | %s %s" "$scur" "$sname" "$sdate" "$sstate" "$sid" "${sdesc:+($sdesc)}")")
      done < <(python3 -c '
import xml.etree.ElementTree as ET, sys
S="\x1f"; c=lambda s:(s or "").replace(S," ").replace("\r"," ").replace("\n"," ").strip()
try:
 r=ET.parse(sys.argv[1]).getroot()
 cur=(sys.argv[2] if len(sys.argv)>2 and sys.argv[2] else r.attrib.get("CurrentSnapshot","")).lower()
 for it in r.iter("SavedStateItem"):
  g=c(it.attrib.get("guid",""))
  if not g: continue
  print(S.join((g," * " if g.lower()==cur else "   ",c(it.findtext("DateTime")) or "N/A",
   c(it.findtext("VmState") or it.findtext("State") or it.attrib.get("state")) or "saved",
   c(it.findtext("Name")) or "Unnamed",c(it.findtext("Description")))))
except Exception: pass
' "$snap_xml" "$active_snap" 2>/dev/null)
    fi

    if (( ${#SNAP_IDS[@]} == 0 )) && [[ -n "$raw_snap" ]]; then
      while IFS= read -r id; do
        [[ -z "$id" ]] && continue
        SNAP_IDS+=("$id")
        [[ "$(lower "$id")" == "$(lower "$active_snap")" ]] && mark=" * " || mark="   "
        SNAP_LINES+=("$(printf "%-3s | %-14.14s | %-19s | %-8s | %s" "$mark" "Snapshot" "N/A" "saved" "$id")")
      done <<< "$(printf '%s\n' "$raw_snap" | awk 'NR>1 {print $NF}' | tr -d '*' | grep -oE '\{[0-9a-fA-F-]{36}\}' | awk '!seen[$0]++')"
    fi
    (( ${#SNAP_IDS[@]} > 0 )) && return 0
    (( rc == 0 )) && return 1
    sleep 0.4
  done
  return 1
}

print_snapshot_table() {
  printf "\n==========================================================================================\n"
  printf " %-4s | %-3s | %-14s | %-19s | %-8s | %s\n" "No." "Cur" "Snapshot Name" "Created Date" "State" "Snapshot UUID / Description"
  echo "------------------------------------------------------------------------------------------"
  for idx in "${!SNAP_IDS[@]}"; do printf " [%2d] | %s\n" "$((idx+1))" "${SNAP_LINES[$idx]}"; done
  echo "=========================================================================================="
}

extract_started_at() {
  local ext="${CUSTOM_DATE:-$(run_root_helper --_extract-date 2>/dev/null)}"
  is_valid_date "$ext" || { err "Could not extract valid 'started_at' from $PLIST (use '-d YYYY-MM-DD' or open Parallels once)."; return 1; }
  [[ "$ext" =~ $DATE_REGEX ]]
  YYYY="${BASH_REMATCH[1]}"; MM="${BASH_REMATCH[2]}"; DD="${BASH_REMATCH[3]}"
  FAKE_YMD="${YYYY}${MM}${DD}"; MAC_DATE="${MM}${DD}1200${YYYY}"
}

# ==============================================================================
# Utility Modes (-k, -l, -x)
# ==============================================================================
if [[ "$MODE" == "kill_only" ]]; then
  acquire_lock; stop_vmsync_daemon
  info "Cleanly stopping Parallels VMs and processes..."
  stop_parallels_cleanly 0; ok "Parallels processes terminated safely."; exit 0
fi

if [[ "$MODE" == "list_only" ]]; then
  resolve_target_vm || { warn "No VM found."; exit 0; }
  load_snapshots "$VM_UUID"
  (( ${#SNAP_IDS[@]} > 0 )) || { warn "No snapshots found for '$VM_NAME'."; exit 0; }
  info "Snapshots for: $VM_NAME ($VM_UUID)"; print_snapshot_table; exit 0
fi

acquire_lock
echo "${C}=== PD-CLEAN v${VERSION} ===${N}"

if [[ "$MODE" == "delete" ]]; then
  resolve_target_vm || die "No VM found."
  [[ "$VM_STATUS" =~ $TRANS_REGEX ]] && VM_STATUS=$(wait_for_vm_settled "$VM_UUID" 80)
  load_snapshots "$VM_UUID"
  (( ${#SNAP_IDS[@]} > 0 )) || { warn "No snapshots found to delete."; exit 0; }
  if [[ -z "$SNAP_ARG" ]]; then
    print_snapshot_table
    read -r -p "Enter snapshot number to DELETE [1-${#SNAP_IDS[@]}, 'all', or 0 to cancel]: " SNAP_ARG
    [[ -z "$SNAP_ARG" || "$SNAP_ARG" == "0" ]] && { info "Canceled."; exit 0; }
  fi
  DEL_TARGETS=()
  if [[ "$SNAP_ARG" == "all" ]]; then
    if (( FORCE_YES == 0 )); then
      read -r -p "Delete ALL ${#SNAP_IDS[@]} snapshot(s)? (y/N): " confirm
      [[ "$confirm" =~ ^[Yy]$ ]] || { info "Canceled."; exit 0; }
    fi
    DEL_TARGETS=("${SNAP_IDS[@]}")
  elif [[ "$SNAP_ARG" =~ ^[0-9]+$ ]] && (( 10#$SNAP_ARG > 0 && 10#$SNAP_ARG <= ${#SNAP_IDS[@]} )); then
    DEL_TARGETS=("${SNAP_IDS[$((10#$SNAP_ARG-1))]}")
  else
    die "Invalid snapshot selection: $SNAP_ARG (Valid: 1-${#SNAP_IDS[@]} or 'all')."
  fi
  DEL_FAILED=0
  for del_id in "${DEL_TARGETS[@]}"; do
    info "Deleting snapshot $del_id..."
    if ! prlctl snapshot-delete "$VM_UUID" --id "$del_id" >/dev/null 2>&1; then
      if (( GUARD_ACTIVE == 0 )); then
        info "Retrying snapshot deletion under bypassed clock..."
        ensure_root_auth; extract_started_at || exit 1; start_time_guard "$MAC_DATE" "$FAKE_YMD" || exit 1
      fi
      prlctl snapshot-delete "$VM_UUID" --id "$del_id" || { err "Failed to delete snapshot $del_id."; DEL_FAILED=1; }
    fi
  done
  stop_time_guard
  (( DEL_FAILED == 0 )) || die "Some snapshots could not be deleted."
  ok "Snapshot deletion completed."; exit 0
fi

# ==============================================================================
# Main Bypass, Launch, Restore & VM Time-Sync Flow
# ==============================================================================
ensure_root_auth
extract_started_at || exit 1
ok "Trial started_at date: ${YYYY}-${MM}-${DD}"

if parallels_running; then
  if (( FORCE_YES == 0 )); then
    read -r -p "Parallels is currently running. Safely restart it? (y/n): " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { info "Canceled."; exit 0; }
  fi
  info "Stopping running Parallels safely..."
  [[ "$MODE" == "latest" || "$MODE" == "index" ]] && stop_parallels_cleanly 1 || stop_parallels_cleanly 0
fi

info "Bypassing clock -> ${YYYY}-${MM}-${DD}..."
start_time_guard "$MAC_DATE" "$FAKE_YMD" || exit 1

info "Starting Parallels Desktop..."
open -a "Parallels Desktop" --args

info "Waiting for Parallels UI..."
ui_ready=0; for (( i=0; i<150; i++ )); do pgrep -x prl_client_app >/dev/null 2>&1 && { ui_ready=1; break; }; sleep 0.2; done
(( ui_ready == 1 )) || die "Timeout waiting for Parallels UI."
ok "Parallels UI detected."

vm_found=0; for (( i=0; i<120; i++ )); do resolve_target_vm && { vm_found=1; break; }; sleep 0.25; done
(( vm_found == 1 )) || die "No VM found (or Parallels dispatcher timeout)."
ok "Target VM: $VM_NAME ($VM_UUID) [State: $VM_STATUS]"
[[ "$VM_STATUS" =~ $TRANS_REGEX ]] && VM_STATUS=$(wait_for_vm_settled "$VM_UUID" 80)

if [[ "$MODE" == "create" ]]; then
  info "Creating new snapshot '$SNAP_ARG'..."
  prlctl snapshot "$VM_UUID" --name "$SNAP_ARG" || die "Failed to create snapshot '$SNAP_ARG'."
  VM_STATUS=$(wait_for_vm_settled "$VM_UUID" 100)
elif [[ "$MODE" != "none" ]]; then
  load_snapshots "$VM_UUID"
  if (( ${#SNAP_IDS[@]} > 0 )); then
    LATEST_IDX=$(( ${#SNAP_IDS[@]} - 1 )); TARGET_SNAP=""
    case "$MODE" in
      latest) TARGET_SNAP="${SNAP_IDS[$LATEST_IDX]}" ;;
      index)
        (( SNAP_ARG > 0 && SNAP_ARG <= ${#SNAP_IDS[@]} )) || die "Invalid snapshot #$SNAP_ARG (Valid: 1-${#SNAP_IDS[@]})."
        TARGET_SNAP="${SNAP_IDS[$((SNAP_ARG-1))]}" ;;
      select)
        print_snapshot_table
        read -r -p "Select snapshot [1-${#SNAP_IDS[@]}] (Enter = latest #$((LATEST_IDX+1)), 0 = skip): " s_choice
        if [[ -z "$s_choice" ]]; then TARGET_SNAP="${SNAP_IDS[$LATEST_IDX]}"
        elif [[ "$s_choice" =~ ^[0-9]+$ ]] && (( 10#$s_choice > 0 && 10#$s_choice <= ${#SNAP_IDS[@]} )); then
          TARGET_SNAP="${SNAP_IDS[$((10#$s_choice-1))]}"
        fi ;;
    esac
    if [[ -n "$TARGET_SNAP" ]]; then
      info "Reverting to snapshot $TARGET_SNAP..."
      prlctl snapshot-switch "$VM_UUID" --id "$TARGET_SNAP" || die "Failed to revert to snapshot $TARGET_SNAP."
      VM_STATUS=$(wait_for_vm_settled "$VM_UUID" 100)
    fi
  else
    warn "No snapshots found; continuing normal startup."
  fi
fi

# Only disable --time-sync on STOPPED VMs (never mutate config.pvs on suspended/running VMs!)
if [[ "$VM_STATUS" == "stopped" || "$VM_STATUS" == "poweroff" ]]; then
  TIME_SYNC_DISABLED_VM="$VM_UUID"
  prlctl set "$VM_UUID" --time-sync off >/dev/null 2>&1 || true
fi

# Single-shot VM ignition with cooldown (prevents double-start/resume race corruption)
LAST_IGNITION_ERR=""
action_cooldown=0
logged_action=0
for (( i=1; i<=60; i++ )); do
  (( i > 1 )) && VM_STATUS=$(vm_status "$VM_UUID")
  case "$VM_STATUS" in
    running)
      if pgrep -x prl_vm_app >/dev/null 2>&1; then
        [[ -z "$VM_LAUNCH_TYPE" ]] && VM_LAUNCH_TYPE="resume"
        ok "VM '$VM_NAME' is running."
        break
      fi ;;
    suspended|paused)
      if (( action_cooldown == 0 )); then
        VM_LAUNCH_TYPE="resume"
        (( logged_action == 0 )) && { info "Resuming VM..."; logged_action=1; }
        if LAST_IGNITION_ERR=$(prlctl resume "$VM_UUID" 2>&1); then action_cooldown=20
        else action_cooldown=2; fi
      fi ;;
    stopped|poweroff)
      if (( action_cooldown == 0 )); then
        VM_LAUNCH_TYPE="start"
        (( logged_action == 0 )) && { info "Starting VM..."; logged_action=1; }
        if LAST_IGNITION_ERR=$(prlctl start "$VM_UUID" 2>&1); then action_cooldown=20
        else action_cooldown=2; fi
      fi ;;
    starting|resuming|reverting|suspending|stopping|snapshotting)
      action_cooldown=2 ;;
  esac
  (( action_cooldown > 0 )) && action_cooldown=$(( action_cooldown - 1 ))
  sleep 0.5
done

if [[ "$VM_STATUS" != "running" ]]; then
  err "VM failed to reach running state (current state: ${VM_STATUS:-unknown})."
  [[ -n "$LAST_IGNITION_ERR" ]] && err "$LAST_IGNITION_ERR"
  exit 1
fi

if (( WAIT_FOR_EXIT == 0 )); then
  sleep 1.5
  info "Restoring macOS time & synchronizing VM time..."
  stop_time_guard
  sync_vm_time "$VM_UUID" "$VM_LAUNCH_TYPE"
  ok "Done! VM '$VM_NAME' is running, macOS time restored & VM time synced."
  exit 0
fi

info "Waiting for Parallels to close... (Press Ctrl+C to restore macOS time without stopping VM)"
while parallels_running; do sleep 2; done
info "Parallels Desktop closed. Restoring macOS time..."
stop_time_guard
ok "Done!"
